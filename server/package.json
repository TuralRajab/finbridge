{
  "name": "@finbridge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "seed": "tsx --disable-warning=ExperimentalWarning src/db/seed.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@finbridge/shared": "*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
