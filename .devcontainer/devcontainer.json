{
  "name": "FinBridge",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postStartCommand": "bash scripts/codespace-start.sh",
  "forwardPorts": [
    4000
  ],
  "portsAttributes": {
    "4000": {
      "label": "FinBridge",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
